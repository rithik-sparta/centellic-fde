/* Represents a condition in a facility agreement that the borrower must meet.
   Financial covenants define a tested metric, operator and threshold;
   non-financial covenants are described in text. Links to a facility.
   Covenants are not edited once tested: an amendment or reset creates a new
   covenant that supersedes the old one, which is closed with an effective_to date. */

{
  "entity": "covenant",
  "primary_key": "covenant_id",
  "foreign_keys": [
    { "key_name": "facility_id", "references": "facility.facility_id" },
    { "key_name": "supersedes_covenant_id", "references": "covenant.covenant_id" }
  ],
  "fields": [
    {"key_name": "covenant_id",    "value_type": "string",  "required": true,  "description": "Unique identifier for the covenant (primary key)" },
    {"key_name": "facility_id",    "value_type": "string",  "required": true,  "description": "Foreign key to the facility this covenant applies to" },
    {"key_name": "covenant_type",  "value_type": "string",  "required": true,  "allowed_values": ["financial", "non_financial"], "description": "Whether the covenant is a tested ratio or an undertaking" },
    {"key_name": "description",    "value_type": "string",  "required": true,  "description": "Plain-language statement of the covenant" },
    {"key_name": "metric",         "value_type": "string",  "required": false, "allowed_values": ["leverage", "interest_cover", "net_worth", "dscr"], "description": "Borrower metric tested. Required when covenant_type is financial, leave None otherwise" },
    {"key_name": "operator",       "value_type": "string",  "required": false, "allowed_values": ["<=", "<", ">=", ">"], "description": "Comparison applied to the metric. Required when covenant_type is financial, leave None otherwise" },
    {"key_name": "threshold",      "value_type": "number",  "required": false, "description": "Limit the metric is tested against. Required when covenant_type is financial" },
    {"key_name": "test_frequency", "value_type": "string",  "required": false, "allowed_values": ["monthly", "quarterly", "semi_annual", "annual", "event_driven"], "description": "How often the covenant is tested" },
    {"key_name": "calculation_basis", "value_type": "string", "required": false, "description": "How the facility agreement defines the tested metric, e.g. whether leases are included and how EBITDA is measured. Required when covenant_type is financial, leave None otherwise" },
    {"key_name": "effective_from", "value_type": "date", "required": true, "description": "Date this version of the covenant starts to apply (DD-MM-YYYY)" },
    {"key_name": "effective_to", "value_type": "date", "required": false, "description": "Date this version of the covenant stops applying (DD-MM-YYYY). Leave None while it is the current version" },
    {"key_name": "supersedes_covenant_id", "value_type": "string", "required": false, "description": "Foreign key to the earlier covenant this one replaces after an amendment or reset. Leave None for an original covenant" }
  ]
}

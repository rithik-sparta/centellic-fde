/* Shows the repayments of a borrower for a facility
*/

{
  "entity": "debt_repayment",
  "primary_key": "repayment_id",
  "foreign_keys": [
    {
      "key_name": "borrower_id",
      "references": "borrower.borrower_id"
    },
    {
      "key_name": "facility_id",
      "references": "facility.facility_id"
    }
  ],
  "fields": [
    {"key_name": "repayment_id", "value_type": "string", "required": true, "description": "Unique identifier for the repayment (primary key)"},
    {"key_name": "borrower_id", "value_type": "string", "required": true, "description": "Foreign key to the borrower making the repayment. Must be the borrower that holds the facility referenced by facility_id"},
    {"key_name": "facility_id", "value_type": "string", "required": true, "description": "Foreign key to the facility this repayment is due under"},
    {"key_name": "due_date", "value_type": "date", "required": true, "description": "Date the repayment falls due (DD-MM-YYYY)"},
    {"key_name": "principal_amount", "value_type": "number", "required": true, "description": "Amount of principal due on the due date, in the currency stated below. Excludes interest and fees"},
    {"key_name": "currency", "value_type": "string", "required": true, "description": "ISO 4217 currency code, e.g. GBP. Must match the currency of the facility"},
    {"key_name": "repayment_type", "value_type": "string", "required": true, "allowed_values": ["scheduled_amortisation", "bullet", "mandatory_prepayment", "other"], "description": "Nature of the repayment: scheduled_amortisation is a regular instalment, bullet is a single repayment of the outstanding balance (usually at maturity), mandatory_prepayment is a repayment required by the facility agreement after an event such as an asset sale, other is anything else"},
    {"key_name": "status", "value_type": "string", "required": true, "allowed_values": ["scheduled", "paid", "part","late", "missed", "waived"], "description": "Current state of the repayment: scheduled (not yet due or awaiting payment), paid (settled), part (debt partly paid), late (overdue and unpaid, or paid after the due date), missed (unpaid and not expected to be paid on time), waived (lender has agreed not to enforce it)" },
    {"key_name": "paid_date", "value_type": "date", "required": false, "description": "Date the repayment was actually paid (DD-MM-YYYY). Leave None until paid" },
    {"key_name": "amount_paid", "value_type": "number", "required": false, "description": "Principal actually paid, in the currency of the repayment. Can be less than principal_amount for a part payment. Leave None until paid" },
    {"key_name": "interest_amount", "value_type": "number", "required": false, "description": "Interest due alongside the principal on the due date, in the currency of the repayment. Together with principal_amount this gives the total debt service for the date" }
  ]
}
